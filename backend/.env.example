# HL Report — copie para .env e preencha. O .env nunca vai para o git.

# ── Banco e segurança ────────────────────────────────────────────────────────
# Produção: sqlite:///./report.db · desenvolvimento: sqlite:///./report_dev.db
# (o banco guarda só login, grupos, configurações e log — os relatórios ficam em arquivos, pasta relatorios/)
DATABASE_URL=sqlite:///./report.db
# Valor próprio deste app (não reutilizar o de outro app). Trocar depois torna ilegível a senha do HANA salva na
# tela de Configurações (é preciso digitá-la de novo).
JWT_SECRET=
# Pasta dos backups automáticos do banco (python migrar.py)
BACKUP_DIR=C:\ProjetosHL\_backups
# Pasta dos relatórios (sql/, config/, templates/). Vazio = ..\relatorios (a do repositório)
RELATORIOS_DIR=

# ── Active Directory ─────────────────────────────────────────────────────────
AD_HOST=
AD_DOMAIN=
AD_NETBIOS=
AD_BASE_DN=

# ── Login local (só desenvolvimento) — na VM: false ─────────────────────────
ALLOW_LOCAL_AUTH=false
LOCAL_ADMIN_USER=admin
LOCAL_ADMIN_PASS=

# ── SAP HANA (valor inicial; depois vale o que estiver salvo em Configurações → API → SAP HANA) ──
HANA_HOST=
HANA_PORT=30015
HANA_USER=
HANA_PASSWORD=
HANA_DATABASE=
HANA_SCHEMA=

# ── Atalhos no trocador de apps (vazio = endereço de produção) ──────────────
APP_HL_LOGISTICA=
APP_HL_BACKOFFICE=
